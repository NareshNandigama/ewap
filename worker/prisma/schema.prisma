// Generated from api/prisma/schema.prisma; edit the canonical API source.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  projects           Project[]
  integrationEvents  IntegrationEvent[]
  knowledgeDocuments KnowledgeDocument[]
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  passwordHash   String
  role           String   @default("MEMBER")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  aiConversations AiConversation[]
}

model Project {
  id             String   @id @default(uuid())
  name           String
  description    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  workflows    Workflow[]

  @@index([organizationId, id])
}

model Workflow {
  id        String   @id @default(uuid())
  name      String
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project       @relation(fields: [projectId], references: [id])
  runs    WorkflowRun[]

  @@index([projectId, id])
}

model WorkflowRun {
  id                String                 @id @default(uuid())
  workflowId        String
  createdAt         DateTime               @default(now())
  completedAt       DateTime?
  idempotencyKey    String?                @unique
  dispatchEnabled   Boolean                @default(false)
  executionToken    String?
  leaseExpiresAt    DateTime?
  executionRetry    Int                    @default(0)
  statusVersion     Int                    @default(0)
  status            WorkflowRunStatus
  workflow          Workflow               @relation(fields: [workflowId], references: [id])
  logs              WorkflowExecutionLog[]
  aiConversations   AiConversation[]
  integrationEvents IntegrationEvent[]

  @@index([workflowId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([leaseExpiresAt])
}

model WorkflowExecutionLog {
  id            String            @id @default(uuid())
  workflowRunId String
  level         ExecutionLogLevel
  message       String
  metadata      Json?
  createdAt     DateTime          @default(now())

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId, createdAt])
}

model AiConversation {
  id            String   @id @default(uuid())
  userId        String
  workflowRunId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  messages    AiMessage[]

  @@index([userId, updatedAt])
  @@index([workflowRunId, updatedAt])
}

model AiMessage {
  id             String        @id @default(uuid())
  conversationId String
  role           AiMessageRole
  content        String
  state          String        @default("COMPLETED")
  finishedAt     DateTime?
  createdAt      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model IntegrationEvent {
  id             String                 @id @default(uuid())
  organizationId String
  workflowRunId  String?
  externalRunId  String
  integration    String
  workflow       String
  stage          String?
  status         IntegrationEventStatus
  errorCode      String?
  errorMessage   String?
  retryable      Boolean?
  correlationId  String?
  idempotencyKey String
  occurredAt     DateTime
  createdAt      DateTime               @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowRun  WorkflowRun? @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, occurredAt])
  @@index([organizationId, externalRunId])
  @@index([organizationId, correlationId])
  @@index([workflowRunId])
}

model KnowledgeDocument {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  source         String?
  content        String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks       KnowledgeChunk[]

  @@index([organizationId, createdAt])
}

model KnowledgeChunk {
  id             String                      @id @default(uuid())
  documentId     String
  chunkIndex     Int
  content        String                      @db.Text
  createdAt      DateTime                    @default(now())
  organizationId String
  embedding      Unsupported("vector(768)")?

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([organizationId])
}

enum IntegrationEventStatus {
  STARTED
  RUNNING
  SUCCESS
  FAILED
  RETRYING
  CANCELLED
}

enum AiMessageRole {
  USER
  ASSISTANT
}

enum ExecutionLogLevel {
  INFO
  WARN
  ERROR
  SUCCESS
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

// Durable dispatch/status hints. Delivery is at least once, keyed for deduplication.
model WorkflowOutbox {
  id          String   @id @default(uuid())
  key         String   @unique
  kind        String
  runId       String
  workflowId  String
  status      String?
  retryCount  Int      @default(0)
  createdAt   DateTime @default(now())
  availableAt DateTime @default(now())
  deliveredAt DateTime?
  leaseToken  String?
  leasedUntil DateTime?

  @@index([kind, deliveredAt, availableAt])
}
