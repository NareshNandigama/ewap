# Set the same independently generated secret in NestJS. Never commit real keys.
AI_SERVICE_API_KEY=

# Default is deterministic. Opt in only after configuring a supported model/key.
AI_ANALYSIS_MODE=deterministic
# OPENAI_API_KEY=
# AI_MODEL=<model supporting Chat Completions strict JSON schema>
AI_MODEL_DEADLINE_SECONDS=15
AI_MODEL_MAX_ATTEMPTS=2
